# Build context is the repo root (docker-compose.yml: `context: .`), but the
# Dockerfile only COPYs langchain_agent/{requirements.txt,*.py,api/,web/}.
# Without this file, BuildKit uploads the entire repo on every build.
# BuildKit only reads <context>/.dockerignore, so this is the one that counts.

.git/

# Large data directories never referenced by the Dockerfile
data/
docs/

# Local dev / tooling, not part of the image
.venv/
**/node_modules/
.pytest_cache/

langchain_agent/.venv/
langchain_agent/tests/
langchain_agent/logs/
langchain_agent/web/node_modules/
langchain_agent/web/dist/
langchain_agent/*.log
langchain_agent/.pytest_cache/

__pycache__/
*.pyc
.env
.env.*
*.egg-info/
.DS_Store
