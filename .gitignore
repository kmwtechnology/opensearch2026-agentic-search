lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version


# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
.vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Claude Code — note: CLAUDE.md and .claude/memory/ are tracked; local state in .claude/state/ is ignored
.claude/state/

# esci directory — raw ESCI dataset (external, not tracked). Anchored (leading
# /) so it doesn't also swallow langchain_agent/lucille-esci/src/main/java/com/kmwllc/esci/
# — an unanchored pattern silently untracked our custom Lucille stage source
# tree from PR #6 onward (AttributeNormalizerStage.java was never committed).
/esci/

# Lucille ETL source tree now lives in an external checkout
# (default ~/github/kmwtechnology/lucille, override via LUCILLE_DIR).
# The in-repo config module is at langchain_agent/lucille-esci/.
# Keep ignoring a repo-root lucille/ as a guard against accidental in-repo
# clones. Anchored (leading /) so it doesn't also swallow docker/lucille/.
/lucille/
langchain_agent/lucille-esci/target/
# Generated products pipeline config (config_generator.py) — regenerated
# fresh before every Lucille run from the OS-backed attribute mapping store,
# never hand-edited or committed. Precisely scoped filename (not a wildcard)
# so this can never repeat the AttributeNormalizerStage.java incident above.
langchain_agent/lucille-esci/conf/products.generated.conf
# Native-path Lucille runtime logs (com.kmwllc.lucille*.log, heartbeat.log,
# failed-documents.jsonl), written to the CWD when running the Runner directly.
/log/
langchain_agent/log/
.claude/settings.local.json
.claude/scheduled_tasks.lock
