# Environment Configuration Example
# Copy this file to .env and adjust values as needed
# All fields marked REQUIRED must be set before running setup.sh

# Login gate (REQUIRED) — shared password the user types into the UI.
# Pick something memorable but not trivial; everyone with this password has
# full access to the app. setup.sh auto-generates this if missing.
LOGIN_PASSWORD=

# Session-cookie signing secret (REQUIRED, 32+ chars).
# Generate with: openssl rand -hex 32
# Rotating this invalidates every active session.
# setup.sh auto-generates this if missing.
SESSION_SECRET=

# Set to false for local HTTP dev so the browser will store the cookie.
# Must be true on Cloud Run (TLS) for production.
SESSION_COOKIE_SECURE=true

# How long a successful login lasts (seconds). 86400 = 24 hours.
SESSION_MAX_AGE_SECONDS=86400

# Admin token for automation (OPTIONAL) — allows calling /api/admin/* endpoints
# without a session cookie. Set to a random string (32+ chars) for production.
# Sent via X-Admin-Token header. Generate with: openssl rand -hex 32
# Leave blank to require session cookie only.
ADMIN_TOKEN=

# Google AI Configuration (REQUIRED) — must be set before running setup.sh
# Get your API key from https://aistudio.google.com/apikey (free tier)
# This enables Gemini LLM responses and embeddings.
GOOGLE_API_KEY=

# PostgreSQL Configuration (checkpoints and conversation metadata)
# Local dev: Docker container on localhost
# GCP: Cloud SQL configured in deploy.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=langchain_agent

# OpenSearch Configuration (document storage and hybrid search)
# Local dev: Docker container on localhost (no auth, no SSL)
# GCP: Hosted instance configured in deploy.sh
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME=agentic_hybrid_search_docs

# LLM Model Selection (Google Gemini)
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0

# Embeddings Model (Google Gemini - must match documents in OpenSearch for hybrid search)
EMBEDDINGS_MODEL=models/gemini-embedding-001

# Reranker Backend (choose one)
# "cross-encoder" (default, ~10ms/batch): local sentence-transformers cross-encoder
# "gemini" (~500ms/batch): Google Gemini LLM-as-reranker
RERANKER_TYPE=cross-encoder

# Cross-encoder model for local reranking (used if RERANKER_TYPE=cross-encoder)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Gemini model for LLM-based reranking (used if RERANKER_TYPE=gemini)
RERANKER_MODEL=gemini-3.1-flash-lite-preview

# Retrieval Configuration
RETRIEVER_K=4                    # Final documents to return
RETRIEVER_FETCH_K=30             # Candidates to fetch before reranking
RETRIEVER_ALPHA=0.25             # Hybrid search: 0.0 = pure lexical/BM25, 1.0 = pure semantic/vector

# Reranker Configuration
ENABLE_RERANKING=true            # Always enabled for best quality
RERANKER_FETCH_K=15              # Candidates to rerank
RERANKER_TOP_K=4                 # Final documents after reranking

# Query Evaluation
ENABLE_QUERY_EVALUATION=true     # Dynamic alpha based on query type
QUERY_EVAL_TIMEOUT_MS=3000       # Timeout for query evaluation
QUERY_EVAL_MODEL=gemini-3.1-flash-lite-preview  # Query evaluator model

# Conversation Settings
DEFAULT_THREAD_ID=default_thread
ENABLE_COMPACTION=true           # Smart context management for long conversations
MAX_CONTEXT_TOKENS=3000          # Conservative estimate for context window

# Logging
LOG_LEVEL=INFO                   # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=console               # Options: console (dev), json (production)

# Lucille ETL — TWO SEPARATE version namespaces, do not conflate:
#   LUCILLE_VERSION     Maven artifact version (single source of truth for
#                       this one — read by scripts/lucille_ingest.sh,
#                       lucille-esci/pom.xml via ${env.LUCILLE_VERSION}, and
#                       .github/workflows/reindex.yml). Resolves
#                       com.kmwllc:lucille-core/-parquet/-bom from Maven
#                       Central.
#   LUCILLE_DOCKER_TAG  Docker Hub tag for kmwtechnology/lucille (the base
#                       image docker/lucille/Dockerfile layers onto).
#                       kmwtechnology's own release-to-docker.yml appends a
#                       docker_revision suffix ("${LUCILLE_VERSION}.${rev}")
#                       that has NO Maven equivalent and isn't safely
#                       derived from LUCILLE_VERSION by string concatenation
#                       — the revision can be nonzero on a Dockerfile-only
#                       re-cut. Check actual tags at
#                       https://hub.docker.com/r/kmwtechnology/lucille/tags
#                       before bumping either variable; using the bare Maven
#                       version as the image tag 404s.
#   LUCILLE_DOCKER_DIGEST  sha256 digest pinning LUCILLE_DOCKER_TAG's exact
#                       content — local dev and GCP/CI both build from this
#                       byte-identical image, immune to any future retag.
#                       Refresh whenever LUCILLE_DOCKER_TAG changes:
#                         docker pull kmwtechnology/lucille:<TAG>
#                         docker image inspect kmwtechnology/lucille:<TAG> \
#                           --format '{{index .RepoDigests 0}}'
LUCILLE_VERSION=0.11.1
LUCILLE_DOCKER_TAG=0.11.1.0
LUCILLE_DOCKER_DIGEST=sha256:cefa9a3b2b9ed4c3cdf92da9abb93da37dc8ba392cc64ef39b81e02387f81073

# LangSmith Observability (optional - for tracing and debugging)
# Get API key from https://smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=agentic-hybrid-search

# Advanced Streaming (experimental)
# Enable token-level streaming via LangGraph's astream_events v2 API
# ENABLE_ASTREAM_EVENTS=true

# Agentic enrichment flywheel (demo-specific) — gates the trigger_enrichment
# agent tool and the /api/admin/enrich endpoint. Writes to the live index
# and the OpenSearch-backed attribute mapping store, and triggers real
# Lucille reindexes, so this stays opt-in outside a demo environment.
# ENABLE_ENRICHMENT_TOOL=true

# Advanced (rarely changed)
VECTOR_DIMENSION=768             # text-embedding-005 with output_dimensionality=768
