# Environment Configuration Example
# Copy this file to .env and adjust values as needed
# All fields marked REQUIRED must be set before running setup.sh

# Every route is same-origin-only (api/middleware/origin_auth.py) -- there is
# no login screen and no session cookie.

# Admin token for automation (OPTIONAL) — allows calling /api/admin/* endpoints
# from a different origin (e.g. a CI runner). Set to a random string (32+
# chars) for production. Sent via X-Admin-Token header. Generate with:
# openssl rand -hex 32. Not wired into any route by default; same-origin
# already covers /api/admin/* for this demo box (see api/routes/admin.py).
ADMIN_TOKEN=

# Google AI Configuration (REQUIRED) — must be set before running setup.sh
# Get your API key from https://aistudio.google.com/apikey (free tier)
# This enables Gemini LLM responses and embeddings.
GOOGLE_API_KEY=

# PostgreSQL Configuration (checkpoints and conversation metadata)
# Local dev: Docker container on localhost
# GCP: Cloud SQL configured in deploy.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=langchain_agent

# OpenSearch Configuration (document storage and hybrid search)
# Local dev: Docker container on localhost (no auth, no SSL)
# GCP: Hosted instance configured in deploy.sh
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME=agentic_hybrid_search_docs
OPENSEARCH_SEARCH_PIPELINE=hybrid_search_pipeline
OPENSEARCH_TIMEOUT=30                            # seconds, per-request client timeout

# Port the FastAPI server listens on. Cloud Run overrides this via its own
# PORT env var at runtime -- rarely set manually outside local dev.
PORT=8000

# LLM Model Selection (Google Gemini). gemini-2.5-flash: avoids Gemini 3's
# mandatory "thinking" tax while still following long system prompts
# reliably -- see core/config.py's LLM_MODEL comment for the full rationale
# (#126; gemini-3.5-flash-lite regresses badly on multi-turn conversations).
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0

# Embeddings Model (Google Gemini - must match documents in OpenSearch for hybrid search)
EMBEDDINGS_MODEL=models/gemini-embedding-001

# In-memory cache for query embeddings (avoids a Google API call for a
# recently-seen query). ENABLE_EMBEDDING_CACHE=false disables it entirely.
ENABLE_EMBEDDING_CACHE=true
EMBEDDING_CACHE_MAX_SIZE=100     # LRU entries

# Reranker Backend (choose one)
# "cross-encoder" (default, ~2s for a 40-doc batch, measured in production):
#     local sentence-transformers cross-encoder, no API call
# "gemini" (~500ms/batch): Google Gemini LLM-as-reranker
RERANKER_TYPE=cross-encoder

# Cross-encoder model for local reranking (used if RERANKER_TYPE=cross-encoder)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Gemini model for LLM-based reranking (used if RERANKER_TYPE=gemini)
RERANKER_MODEL=gemini-3.1-flash-lite-preview
RERANKER_BATCH_SIZE=20           # Cross-encoder docs scored per batch
RERANKER_WARMUP_ENABLED=true     # Run one throwaway inference at startup so the
                                  # first real request isn't slowed by lazy model load

# Quality Gate — retries retrieval with adjusted alpha when the reranker's
# top score is below threshold. Intent-specific thresholds in main.py
# override this default per request type.
ENABLE_QUALITY_GATE=true
QUALITY_GATE_THRESHOLD=0.5

# Query Evaluation
QUERY_EVAL_MODEL=gemini-2.5-flash-lite  # Query evaluator model
QUERY_EVAL_TEMPERATURE=0
QUERY_EVAL_MAX_TOKENS=1024

# Max wait (seconds) for the pipeline's alpha_estimator_llm calls (retriever
# attribute extraction, follow-up query expansion, and query-evaluator alpha
# estimation above) — none has a timeout of its own otherwise; falls back
# gracefully (no filters / original query / collection-default alpha)
# rather than blocking the turn (issue #117/#120/#122).
ALPHA_ESTIMATOR_CALL_TIMEOUT_SECONDS=5

# LLM-as-judge model (post-response hallucination/faithfulness check).
# Enabled per-request via the frontend's optimizations toggle, not a global
# env var here.
JUDGE_MODEL=gemini-2.5-flash-lite

# Citation link verification — checks that a product citation URL is
# actually reachable before showing it, replacing broken ones.
ENABLE_LINK_VERIFICATION=true
LINK_VERIFICATION_TIMEOUT_MS=2000
LINK_CACHE_TTL_MINUTES=60        # How long a verified/broken URL result is cached
MIN_VALID_DOCUMENTS=10           # Floor on documents after replacing broken-link ones

# ESCI product data ingest (used by setup.py / scripts/lucille_ingest.sh)
ESCI_INGEST_LIMIT=10000          # Max products to load
ESCI_PRODUCT_LOCALE=us           # ESCI dataset locale: us, es, or jp

# --- The block below is NOT read from the environment (see #26) ---
# Every value here is a plain Python literal in config.py, not an
# os.getenv(...) call. Setting these in your .env has NO EFFECT -- they're
# listed for reference only, with their real hardcoded values. If you need
# one of these to actually be configurable, wire it to os.getenv(...) in
# config.py first.
#
# Retrieval: RETRIEVER_K=10, RETRIEVER_FETCH_K=40, RETRIEVER_ALPHA=0.25
#            (usually overridden per-query by the query evaluator)
# Reranker:  ENABLE_RERANKING=true, RERANKER_FETCH_K=40, RERANKER_TOP_K=10
# Query evaluation: ENABLE_QUERY_EVALUATION=true
#                   (timeout is ALPHA_ESTIMATOR_CALL_TIMEOUT_SECONDS above -- real and env-overridable)
# Conversation: DEFAULT_THREAD_ID=default_thread, ENABLE_COMPACTION=true,
#               MAX_CONTEXT_TOKENS=3000
# Embeddings: VECTOR_DIMENSION=768 (also hardcoded -- see below)

# Logging
LOG_LEVEL=INFO                   # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=console               # Options: console (dev), json (production)

# Lucille ETL — TWO SEPARATE version namespaces, do not conflate:
#   LUCILLE_VERSION     Maven artifact version (single source of truth for
#                       this one — read by scripts/lucille_ingest.sh and
#                       lucille-esci/pom.xml via ${env.LUCILLE_VERSION}).
#                       Resolves com.kmwllc:lucille-core/-parquet/-bom from
#                       Maven Central.
#   LUCILLE_DOCKER_TAG  Docker Hub tag for kmwtechnology/lucille (the base
#                       image docker/lucille/Dockerfile layers onto).
#                       kmwtechnology's own release-to-docker.yml appends a
#                       docker_revision suffix ("${LUCILLE_VERSION}.${rev}")
#                       that has NO Maven equivalent and isn't safely
#                       derived from LUCILLE_VERSION by string concatenation
#                       — the revision can be nonzero on a Dockerfile-only
#                       re-cut. Check actual tags at
#                       https://hub.docker.com/r/kmwtechnology/lucille/tags
#                       before bumping either variable; using the bare Maven
#                       version as the image tag 404s.
#   LUCILLE_DOCKER_DIGEST  sha256 digest pinning LUCILLE_DOCKER_TAG's exact
#                       content — local dev and GCP/CI both build from this
#                       byte-identical image, immune to any future retag.
#                       Refresh whenever LUCILLE_DOCKER_TAG changes:
#                         docker pull kmwtechnology/lucille:<TAG>
#                         docker image inspect kmwtechnology/lucille:<TAG> \
#                           --format '{{index .RepoDigests 0}}'
LUCILLE_VERSION=0.11.1
LUCILLE_DOCKER_TAG=0.11.1.0
LUCILLE_DOCKER_DIGEST=sha256:cefa9a3b2b9ed4c3cdf92da9abb93da37dc8ba392cc64ef39b81e02387f81073

# LangSmith Observability (optional - for tracing and debugging)
# Get API key from https://smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=agentic-hybrid-search

# OpenTelemetry GenAI tracing to Oodle (optional - off unless the endpoint is set)
# Traces every LangGraph node and Gemini call (model, tokens, cost, prompts).
# Endpoint, key and instance come from `oodle integrations list -o json` /
# `oodle api-keys list -o json` / `oodle auth status -o json`.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<otlpCollectorDomain>
# OTEL_EXPORTER_OTLP_HEADERS=X-API-KEY=<oodle-api-key>,X-OODLE-INSTANCE=<instance-id>
# OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# OTEL_SERVICE_NAME=agentic-hybrid-search
# TRACELOOP_TRACE_CONTENT=false   # uncomment to drop prompt/response text

# Advanced Streaming (experimental)
# Enable token-level streaming via LangGraph's astream_events v2 API
# ENABLE_ASTREAM_EVENTS=true

# Agentic enrichment flywheel (demo-specific) — gates the trigger_enrichment
# agent tool and the /api/admin/enrich endpoint. Writes to the live index
# and the OpenSearch-backed attribute mapping store, and triggers real
# Lucille reindexes, so this stays opt-in outside a demo environment.
# ENABLE_ENRICHMENT_TOOL=true

# How the flywheel triggers the catalog reindex after writing a mapping:
# runs scripts/lucille_ingest.sh here (Docker on this host, ~20s). Only
# "local" is supported.
# REINDEX_TRIGGER=local
# REINDEX_LOCAL_TIMEOUT_SECONDS=180
