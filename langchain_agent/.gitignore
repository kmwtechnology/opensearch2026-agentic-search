# Additions to the repo-root .gitignore for this directory.

# Editors / OS
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local environment overrides
.env.local
.env.*.local

# Runtime output
logs/
*.log
*.pid

# Claude Code local state
.claude/

# Web UI
web/node_modules/
web/dist/
# tsc build artifacts -- vite.config.js/.d.ts shadow vite.config.ts (vite resolves
# .js before .ts, see #27); tsbuildinfo is a compiler cache, neither belongs in git
web/vite.config.js
web/vite.config.d.ts
web/*.tsbuildinfo
