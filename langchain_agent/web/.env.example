# Backend URL. Leave unset for local dev: the Vite dev server (:5173) proxies
# /api and /ws to the native backend on :8080 (see vite.config.ts), and the
# demo container serves the UI same-origin, so relative URLs work in both.
# Only set this if the UI and API are on different origins with no proxy.
# VITE_API_URL=http://localhost:8080
